{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "/apps/web/**",
      "/apps/worker/**",
      "/assets/**",
      "/libs/**",
      "/tools/**",
      "/patches/**",
      "/package.json",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml",
      "/nx.json",
      "/tsconfig*.json",
      "/.node-version",
      "/styles.base.css",
      "/.postcssrc.json",
      "/railway.json",
      "/Dockerfile",
      "/.dockerignore",
      "/.railway/**"
    ]
  },
  "deploy": {
    "healthcheckPath": "/api/ready",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
