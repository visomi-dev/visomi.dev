{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "paths": {
      "@visomi-stack/backend-shared/*": ["./libs/backend/shared/src/*"],
      "@visomi-stack/web-backend-shared/*": ["./libs/web/backend/shared/src/*"],
      "@visomi-stack/web-shared-observability/*": ["./libs/web/shared/observability/src/*"],
      "@visomi-stack/web-frontend-ui/*": ["./libs/web/frontend/ui/src/*"],
      "@visomi-stack/dev-testing/*": ["./libs/development/testing/src/*"],
      "@visomi.dev/shared-social-images/*": ["./libs/shared/social-images/src/*"]
    },
    "ignoreDeprecations": "6.0"
  },
  "exclude": ["node_modules", "tmp"]
}
