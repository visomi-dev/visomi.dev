# Names/placeholders only. Never copy local credentials into this file.
HOST=127.0.0.1
PORT=8080
SITE_URL=https://visomi.dev
DATABASE_URL=
REDIS_URL=
# Verified proxy addresses/CIDRs; or 1-hop only for a reviewed sanitizing ingress (see apps/web/api/README.md).
AUTH_TRUST_PROXY=
AUTH_ORIGIN=
AUTH_RP_ID=
SESSION_SECRET=
OWNER_EMAIL=
OWNER_USER_ID=
AUTH_TOTP_ENCRYPTION_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SOCIAL_IMAGE_INTERNAL_TOKEN=
PUPPETEER_EXECUTABLE_PATH=
WORKER_CONCURRENCY=1
DISABLE_WORKER=false
VISOMI_PRIVATE_METRICS=false
# CONTACT_API_URL / CONTACT_PROXY_SECRET are set internally by the composed gateway.
# Offline recovery tools only; never used by the running website/API:
CONTACT_LEGACY_DATABASE_URL=
CONTACT_LEGACY_DATABASE_AUTH_TOKEN=

# Leave all three empty to disable server trace export. Set the full set for an authenticated private receiver.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=
OTEL_EXPORTER_OTLP_HEADERS=
