{
  "name": "app-e2e",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/web/app-e2e/src",
  "implicitDependencies": ["web-gateway"],
  "// targets": "to see all targets run: nx show project app-e2e --web",
  "targets": {
    "e2e": {
      "dependsOn": ["web-gateway:build"],
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/tools/testing/**/*",
        "{workspaceRoot}/compose*.yaml",
        "{workspaceRoot}/pnpm-workspace.yaml",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/pnpm-lock.yaml"
      ]
    }
  }
}
