{
  "name": "site-e2e",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/web/site-e2e/src",
  "implicitDependencies": ["web-gateway"],
  "// targets": "to see all targets run: nx show project website-e2e --web",
  "targets": {
    "e2e": {
      "dependsOn": ["web-gateway:build"],
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/tools/testing/**/*",
        "{workspaceRoot}/compose*.yaml",
        "{workspaceRoot}/pnpm-workspace.yaml",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/pnpm-lock.yaml",
        "{workspaceRoot}/docs/migration/parity/**/*",
        "{workspaceRoot}/scripts/*parity*.mjs"
      ]
    },
    "screenshots": {
      "executor": "nx:run-commands",
      "dependsOn": ["web-gateway:build"],
      "options": {
        "command": "pnpm exec playwright test --config apps/web/site-e2e/playwright.screenshots.config.ts --max-failures=1",
        "cwd": "."
      }
    },
    "screenshots-contact": {
      "executor": "nx:run-commands",
      "dependsOn": ["web-gateway:build"],
      "options": {
        "command": "pnpm exec playwright test --config apps/web/site-e2e/playwright.screenshots.config.ts apps/web/site-e2e/src/website-screenshots-contact.spec.ts --max-failures=1",
        "cwd": "."
      }
    },
    "screenshots-home": {
      "executor": "nx:run-commands",
      "dependsOn": ["web-gateway:build"],
      "options": {
        "command": "pnpm exec playwright test --config apps/web/site-e2e/playwright.screenshots.config.ts apps/web/site-e2e/src/website-screenshots-home.spec.ts --max-failures=1",
        "cwd": "."
      }
    },
    "screenshots-journey": {
      "executor": "nx:run-commands",
      "dependsOn": ["web-gateway:build"],
      "options": {
        "command": "pnpm exec playwright test --config apps/web/site-e2e/playwright.screenshots.config.ts apps/web/site-e2e/src/website-screenshots-journey.spec.ts --max-failures=1",
        "cwd": "."
      }
    },
    "screenshots-projects": {
      "executor": "nx:run-commands",
      "dependsOn": ["web-gateway:build"],
      "options": {
        "command": "pnpm exec playwright test --config apps/web/site-e2e/playwright.screenshots.config.ts apps/web/site-e2e/src/website-screenshots-projects.spec.ts --max-failures=1",
        "cwd": "."
      }
    },
    "screenshots-resume": {
      "executor": "nx:run-commands",
      "dependsOn": ["web-gateway:build"],
      "options": {
        "command": "pnpm exec playwright test --config apps/web/site-e2e/playwright.screenshots.config.ts apps/web/site-e2e/src/website-screenshots-resume.spec.ts --max-failures=1",
        "cwd": "."
      }
    },
    "screenshots-resume-print": {
      "executor": "nx:run-commands",
      "dependsOn": ["site:build"],
      "options": {
        "command": "pnpm exec playwright test --config apps/web/site-e2e/playwright.screenshots.config.ts apps/web/site-e2e/src/website-screenshots-resume-print.spec.ts --max-failures=1",
        "cwd": "."
      }
    },
    "e2e-ci": {
      "dependsOn": ["web-gateway:build"]
    }
  }
}
