---
import type { Locale } from '../i18n/translations';

type Props = { locale: Locale };

const { locale } = Astro.props;
---

<div
  id="page-navigation-loader"
  class="pointer-events-none fixed inset-x-0 top-0 z-60"
  hidden
  transition:persist
  transition:persist-props
  data-print-hidden
>
  <div class="h-0.5 overflow-hidden bg-blue-600/15 dark:bg-blue-400/15" aria-hidden="true">
    <div class="navigation-progress h-full w-2/5 bg-blue-600 dark:bg-blue-400"></div>
  </div>

  <span role="status" aria-live="polite" aria-atomic="true" class="sr-only">
    {locale === 'es' ? 'Cargando página' : 'Loading page'}
  </span>
</div>

<script src="../scripts/page-navigation-loader.ts"></script>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .navigation-progress {
      animation: navigation-progress-slide 1.2s ease-in-out infinite;
    }
  }

  @keyframes navigation-progress-slide {
    from {
      transform: translateX(-100%);
    }
    to {
      transform: translateX(250%);
    }
  }
</style>
