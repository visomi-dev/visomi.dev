---
import { themeSwitcher } from '@visomi-stack/web-frontend-ui/lib/theme-switcher';

import type { Locale } from '../i18n/translations';

type Props = { locale: Locale };
const { locale } = Astro.props;
---

<button
  type="button"
  data-theme-switcher
  disabled
  aria-label={locale === 'es' ? 'Tema oscuro' : 'Dark theme'}
  aria-pressed="false"
  class:list={[
    themeSwitcher.foundation,
    'size-10 rounded-md transition-colors hover:bg-neutral-200 dark:hover:bg-neutral-800',
  ]}
>
  <svg
    class:list={[themeSwitcher.sunFoundation, 'size-7 text-yellow-400']}
    aria-hidden="true"
    viewBox="0 0 24 24"
    fill="currentColor"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d={themeSwitcher.sunPath} />
  </svg>

  <svg
    class:list={[themeSwitcher.moonFoundation, 'size-6 text-white']}
    aria-hidden="true"
    viewBox="0 0 24 24"
    fill="currentColor"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d={themeSwitcher.moonPath} />
  </svg>
</button>

<script src="../scripts/theme-switcher.ts"></script>
