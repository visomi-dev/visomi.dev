---
import { browserPrivacyCopy } from '@visomi-stack/web-shared-observability/lib/privacy-copy';
import { screens } from '@visomi-stack/web-shared-observability/lib/contract';
import { button } from '@visomi-stack/web-frontend-ui/lib/button';
import { dialog } from '@visomi-stack/web-frontend-ui/lib/overlays';
import type { Locale } from '../i18n/translations';

type Props = { locale: Locale };
const copy = browserPrivacyCopy[Astro.props.locale];
---

<div class="contents" data-browser-privacy>
  <button
    type="button"
    hidden
    class:list={[button.classes({ variant: 'ghost', size: 'icon' }), '[hidden]:hidden']}
    title={copy.pending}
    data-open
    aria-haspopup="dialog"
    aria-controls="browser-privacy"
  >
    <span class="pi pi-exclamation-circle" aria-hidden="true"></span>

    <span class="sr-only">{copy.pending}</span>
  </button>

  <dialog id="browser-privacy" aria-labelledby="browser-privacy-title" class:list={[dialog.classes(), 'max-sm:p-4']}>
    <div class="space-y-4">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h2 id="browser-privacy-title" class="font-heading text-lg font-semibold">
          {copy.reportsTitle}
        </h2>

        <button type="button" class={button.classes({ variant: 'secondary', size: 'sm' })} data-close autofocus>
          {copy.close}
        </button>
      </div>

      <div role="region" hidden class="space-y-3" aria-labelledby="browser-privacy-reports" data-reports>
        <h3 id="browser-privacy-reports" class="font-heading font-semibold">
          {copy.reports}
        </h3>

        <p class="text-sm">{copy.manual}</p>

        <ul class="space-y-3"></ul>
      </div>

      <p class="empty:hidden" role="status" data-feedback data-sent={copy.sent} data-failed={copy.failed}></p>
    </div>
  </dialog>

  <template
    data-unhandled_exception={copy.exception}
    data-unhandled_rejection={copy.rejection}
    data-startup_failed={copy.startup}
    data-unknown-kind={copy.unknownKind}
    {...Object.fromEntries(screens.map((screen) => ['data-' + screen, copy[screen]]))}
  >
    <li class="space-y-2 rounded-lg border border-zinc-300 p-3 dark:border-zinc-700">
      <dl class="grid grid-cols-[auto_1fr] gap-x-3 text-sm">
        <dt>{copy.type}</dt>

        <dd data-type></dd>

        <dt>{copy.kind}</dt>

        <dd data-kind></dd>

        <dt>{copy.screen}</dt>

        <dd data-screen></dd>
      </dl>

      <div class="flex flex-wrap gap-2">
        <button type="button" class={button.classes({ variant: 'secondary', size: 'sm' })} data-send>
          {copy.send}
        </button>

        <button type="button" class={button.classes({ variant: 'secondary', size: 'sm' })} data-discard>
          {copy.discard}
        </button>
      </div>
    </li>
  </template>
</div>
